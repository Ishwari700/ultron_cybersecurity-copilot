# Enforce deterministic LF line endings across all platforms to protect cryptographic hashes
* text=auto eol=lf

# Explicitly ensure evaluation data and pinned documents retain LF
data/eval/* text eol=lf
data/vapt_corpus/* text eol=lf
docs/*.md text eol=lf
reports/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.sqlite binary
*.sqlite3 binary
*.db binary
*.bin binary
*.onnx binary
*.index binary
